# Public address (canonicals, sitemap, structured data). Set on the production deployment.
NEXT_PUBLIC_SITE_URL=https://clinic.avvvs.com
# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Booking requests are emailed by SMTP. Without these, `npm run dev` prints requests to the terminal.
MAIL_TO=avvvsayurspecialityclinic@gmail.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# true sends the patient a short acknowledgement when they gave an email
SEND_ACK=false

# --- the admin (/admin) ---
# Neon Postgres (Vercel Marketplace sets it). Tables are prefixed clinic_, so the avvvs.com database can be shared.
# Leave empty in development to use the local PGlite database in .data/.
DATABASE_URL=
# Vercel Blob for uploaded images (set by adding a Blob store). Empty in development: uploads go to public/uploads.
BLOB_READ_WRITE_TOKEN=
# Any long random phrase; needed once in production to create the first admin at /admin/setup.
ADMIN_SETUP_KEY=
