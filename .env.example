# Public address (canonicals, sitemap, structured data). Set on the production deployment.
NEXT_PUBLIC_SITE_URL=https://clinic.avvvs.com
# --- search and analytics ---
# Google Search Console: the content of the HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools (msvalidate.01). Bing also feeds ChatGPT search and Copilot.
NEXT_PUBLIC_BING_VERIFICATION=
# Meta Business: domain verification token
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
# GA4 measurement ID (G-XXXXXXX) and Meta Pixel ID. Both load only after the visitor allows them.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# IndexNow key (any 32 hex characters): published articles, treatments and doctors are announced to Bing and Yandex
INDEXNOW_KEY=

# Booking requests are emailed by SMTP. Without these, `npm run dev` prints requests to the terminal.
MAIL_TO=avvvsayurspecialityclinic@gmail.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# true sends the patient a short acknowledgement when they gave an email
SEND_ACK=false

# --- the admin (/admin) ---
# Neon Postgres (Vercel Marketplace sets it). Tables are prefixed clinic_, so the avvvs.com database can be shared.
# Leave empty in development to use the local PGlite database in .data/.
DATABASE_URL=
# Vercel Blob for uploaded images (set by adding a Blob store). Empty in development: uploads go to public/uploads.
BLOB_READ_WRITE_TOKEN=
# Any long random phrase; needed once in production to create the first admin at /admin/setup.
ADMIN_SETUP_KEY=

# --- online consultations (/consult) ---
# Google Cloud OAuth "Web application" client for the clinic's Google account. Redirect URI:
#   https://clinic.avvvs.com/api/google/callback   (and http://localhost:3000/api/google/callback to try it locally)
# Then connect the account once in Admin -> Settings. Empty in development: bookings use a placeholder Meet link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Which calendar to use (default: the account's main calendar)
GOOGLE_CALENDAR_ID=
# A long random phrase: encrypts the stored Google connection. Changing it means connecting Google again.
APP_SECRET=
# A long random phrase: lets Vercel's daily cron send the morning reminders (/api/cron/reminders)
CRON_SECRET=
